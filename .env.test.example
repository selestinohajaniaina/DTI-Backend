# Copy to `.env.test` for the test suite. Never commit `.env.test`.
NODE_ENV=test
# Must point to a DEDICATED test database (name containing "test").
# Tests truncate tables; the name guard refuses dev/prod databases.
TEST_DATABASE_URL=postgres://dti:change-me@localhost:5433/dti_test
# Test-only secret (still needs 32+ characters for schema parity with prod).
JWT_SECRET=replace-with-a-random-test-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
# Low cost factor keeps the suite fast. Never use in development/production.
BCRYPT_ROUNDS=4
FRONTEND_URL=http://localhost:4200
# Fake key for the suite: AI tests stub fetch and never call Meta.
MODEL_API_KEY=test-key-not-a-real-secret
