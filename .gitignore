node_modules/
dist/
coverage/
# Never commit in-place tsc output: stale .js next to sources shadows the
# .ts files under Vitest (and breaks lint/format). Build output goes to dist/.
src/**/*.js
.env
.env.test
.env.*.local
*.log
.DS_Store
# Generated images are runtime artifacts, but the directory skeleton is
# tracked via .gitkeep so fresh clones and deploys contain uploads/generated/.
# (Negations must list the directory chain: files under an excluded directory
# cannot be re-included.)
uploads/*
!uploads/.gitkeep
!uploads/generated/
uploads/generated/*
!uploads/generated/.gitkeep
test-uploads/
