# Copy to `.env` and fill in real values. Never commit `.env`.
NODE_ENV=development
PORT=3000
# Local dev binds to localhost. Leave unset (defaults to 0.0.0.0) on hosts
# like Render that require listening on all interfaces.
HOST=127.0.0.1
# Comma-separated list of allowed frontend origins (CORS). Local dev default.
# Production additionally requires https://dti-ai.vercel.app — it is already
# part of the code default when FRONTEND_URL is left unset (see README).
FRONTEND_URL=http://localhost:4200

# External PostgreSQL connection string (managed provider or local server).
# Example with a local PostgreSQL on the default port:
DATABASE_URL=postgres://dti:change-me@localhost:5432/dti
# Alternative to DATABASE_URL: set DB_HOST, DB_PORT, DB_NAME, DB_USER (+ DB_PASSWORD).

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars-long
# Short-lived access token. Units: ms, s, m, h, d, w, y (bare number = seconds).
JWT_EXPIRES_IN=15m

# bcrypt cost factor (4-31). Keep 12+ outside tests.
BCRYPT_ROUNDS=12

# Managed Postgres with TLS: set to "true" (certificate verified by default).
DB_SSL=false
# Certificate verification for TLS connections ("true" by default — keep it).
# Set to "false" ONLY for Render *internal* database URLs: Render documents
# that internal connections use self-signed certificates (`sslmode=require`,
# verify-ca/verify-full unsupported). External URLs keep "true".
DB_SSL_REJECT_UNAUTHORIZED=true
# Log every SQL statement ("true"/"false"). Off by default: query text can
# contain sensitive values.
DB_LOGGING=false
# Refuse `npm run db:seed` in production unless explicitly allowed.
ALLOW_SEED_IN_PRODUCTION=false

# Meta Muse AI (Responses API). Required only for POST /api/ai/test.
# Create one at https://dev.meta.ai (dashboard). Never commit the real value.
MODEL_API_KEY=

# Upcycling ideas requested per photo (integer, 1-10). Each idea costs one
# image-generation request, so higher values are slower and pricier.
GENERATED_IDEAS_COUNT=5

# Directory for backend-managed generated images (created automatically).
UPLOAD_DIR=uploads

# Optional Meta API base override (staging, mocks). Default: https://api.meta.ai/v1
# META_API_BASE=https://api.meta.ai/v1
