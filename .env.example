# Copy to `.env` and fill in real values. Never commit `.env`.
NODE_ENV=development
PORT=3000
# Local dev binds to localhost; Compose overrides this to 0.0.0.0 in the container.
HOST=127.0.0.1
# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:4200

# Local development: database runs via `docker compose up -d db` (host port 5433).
DATABASE_URL=postgres://dti:change-me@localhost:5433/dti
# Alternative to DATABASE_URL: set DB_HOST, DB_PORT, DB_NAME, DB_USER (+ DB_PASSWORD).
# Compose uses the POSTGRES_* variables below to initialize the database.
POSTGRES_USER=dti
# URL-safe characters only (letters/numbers); Compose interpolates it into DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dti
DB_HOST_PORT=5433

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars-long
# Short-lived access token. Units: ms, s, m, h, d, w, y (bare number = seconds).
JWT_EXPIRES_IN=15m

# bcrypt cost factor (4-31). Keep 12+ outside tests.
BCRYPT_ROUNDS=12

# Managed Postgres with TLS: set to "true" (valid certificate required).
DB_SSL=false
# Log every SQL statement ("true"/"false"). Off by default: query text can
# contain sensitive values.
DB_LOGGING=false
# Refuse `npm run db:seed` in production unless explicitly allowed.
ALLOW_SEED_IN_PRODUCTION=false

# Meta Muse AI (Responses API). Required only for POST /api/ai/test.
# Create one at https://dev.meta.ai (dashboard). Never commit the real value.
MODEL_API_KEY=
